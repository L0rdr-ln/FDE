[Icon Theme]
Name=FDE
Comment=Glossy glass icons for the Frutiger Desktop Environment
Inherits=Adwaita,hicolor
Directories=scalable/actions,scalable/apps,scalable/mimetypes,scalable/places,scalable/status

[scalable/actions]
Context=Actions
Size=128
MinSize=16
MaxSize=512
Type=Scalable

[scalable/apps]
Context=Applications
Size=128
MinSize=16
MaxSize=512
Type=Scalable

[scalable/mimetypes]
Context=MimeTypes
Size=128
MinSize=16
MaxSize=512
Type=Scalable

[scalable/places]
Context=Places
Size=128
MinSize=16
MaxSize=512
Type=Scalable

[scalable/status]
Context=Status
Size=128
MinSize=16
MaxSize=512
Type=Scalable

